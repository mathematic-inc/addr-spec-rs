amends ".hk/org.pkl"

local rustFiles = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml", "**/*.rs")
local slow = List("slow")

// `--all-features` would enable `nightly`, which needs a nightly compiler.
local stableFeatures = "comments,email_address,literals,normalization,serde,white-spaces"

steps {
  ["cargo-lockfile"] {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = slow
  }
  ["cargo-test-stable-features"] {
    glob = rustFiles
    workspace_indicator = null
    check = "cargo test --locked --no-default-features --features \(stableFeatures)"
    profiles = slow
  }
  // The organization's step sets `workspace_indicator = null`, so `{{workspace}}` has no value.
  ["cargo-deny"] { dir = "{{root}}" }
  ["cargo-clippy"] {
    check =
      "cargo clippy --workspace --no-default-features --features \(stableFeatures) --all-targets -- -D warnings"
    fix =
      "cargo clippy --fix --workspace --no-default-features --features \(stableFeatures) --all-targets --allow-dirty --allow-staged -- -D warnings"
  }
}
